[gd_resource type="ShaderMaterial" load_steps=4 format=3]

; Water for the whole county - Blackwater Lake, the Blackwater and Mill Creek all
; share one material, differing only in the flow field CountyWater bakes into
; vertex colour. One material means one shader compile and one draw-call family
; rather than three.
;
; The ripple normal map is generated by Godot's own seamless noise rather than
; downloaded. A tiling water normal is pure high-frequency detail with no
; photographic content to preserve, so a scanned texture buys nothing here, and a
; procedural one is guaranteed seamless - a visible repeat seam on a lake surface
; is glaring in a way it never is on ground.

[ext_resource type="Shader" path="res://assets/materials/county_water.gdshader" id="0_shader"]

[sub_resource type="FastNoiseLite" id="RippleNoise"]
noise_type = 1
seed = 7714
frequency = 0.024
fractal_type = 1
fractal_octaves = 4
fractal_lacunarity = 2.1
fractal_gain = 0.55

[sub_resource type="NoiseTexture2D" id="WaveNormal"]
width = 512
height = 512
seamless = true
seamless_blend_skirt = 0.2
as_normal_map = true
bump_strength = 5.5
noise = SubResource("RippleNoise")

[resource]
render_priority = 1
shader = ExtResource("0_shader")

shader_parameter/wave_normal = SubResource("WaveNormal")

; Absorption is per-channel in inverse metres: red is extinguished first, which is
; what turns a metre of clear water green and five metres of it blue-black.
shader_parameter/absorption = Vector3(0.46, 0.19, 0.26)
shader_parameter/scatter_color = Color(0.088, 0.15, 0.132, 1)
shader_parameter/deep_color = Color(0.017, 0.04, 0.046, 1)
shader_parameter/depth_opaque = 8.0

; A county river carrying silt off logging country is not a swimming pool.
shader_parameter/turbidity = 0.45

shader_parameter/macro_scale = 0.045
shader_parameter/detail_scale = 0.19
shader_parameter/macro_strength = 1.05
shader_parameter/detail_strength = 0.55
shader_parameter/flow_cycle = 0.13
shader_parameter/flow_metres = 26.0
shader_parameter/drift_speed = 0.035
shader_parameter/water_roughness = 0.075
shader_parameter/wave_height = 0.16
shader_parameter/wave_length = 13.0

shader_parameter/refraction_strength = 0.055
shader_parameter/refraction_blur = 0.3
shader_parameter/fresnel_power = 5.0
shader_parameter/sky_tint = Color(0.4, 0.5, 0.6, 1)
shader_parameter/sky_reflection = 0.55

shader_parameter/foam_color = Color(0.855, 0.88, 0.87, 1)
shader_parameter/shore_foam_depth = 1.6
shader_parameter/shore_foam_amount = 1.0
shader_parameter/rapid_foam = 0.9
shader_parameter/rapid_threshold = 0.34
shader_parameter/foam_scale = 0.3
shader_parameter/shore_alpha_fade = 0.45
