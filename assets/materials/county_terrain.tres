[gd_resource type="ShaderMaterial" load_steps=14 format=3]

; Ground material for the whole open county. Four Poly Haven CC0 2K PBR sets are
; blended by the weights CountyTerrain bakes into vertex colour, so the shader
; never has to re-derive biome, slope or field data that the mesher already knew.
;
; Tiling scales are chosen against the 4m ring-0 vertex spacing: anything finer
; than about 3m starts to alias into shimmer at the far LODs, and anything coarser
; than about 7m loses its grain underfoot.

[ext_resource type="Shader" path="res://assets/materials/county_terrain.gdshader" id="0_shader"]

