[sub_resource type="Shader" id="PuddleShader"]
code = "shader_type spatial;\nrender_mode blend_mix, depth_prepass_alpha, cull_disabled;\n\nvoid fragment() {\n    vec2 p = (UV * 2.0) - vec2(1.0);\n    float angle = atan(p.y, p.x);\n    float radius = length(p);\n    float edge_shape = 0.78\n        + (sin((angle * 3.0) + 0.7) * 0.09)\n        + (sin((angle * 7.0) - 1.2) * 0.055)\n        + (sin((angle * 11.0) + 2.1) * 0.025);\n    float coverage = 1.0 - smoothstep(edge_shape - 0.085, edge_shape, radius);\n    float shallow_variation = 0.88 + (sin((p.x * 8.0) + (p.y * 5.0)) * 0.05);\n    ALBEDO = vec3(0.025, 0.04, 0.052) * shallow_variation;\n    METALLIC = 0.22;\n    ROUGHNESS = 0.18;\n    SPECULAR = 0.78;\n    ALPHA = coverage * 0.66;\n}\n"

[sub_resource type="ShaderMaterial" id="PuddleMaterial"]
