# Godot 4+ specific ignores
.godot/
/android/

# Download archives
*.zip
*.7z
*.rar

# Optional raw authoring files
# Remove this rule if Blender files become project source assets.
*.blend


# .NET output
bin/
obj/

# Local Claude agent worktrees must never be committed as project content.
.claude/worktrees/

# Poly Haven raw download cache (source material for tools/blender pipeline,
